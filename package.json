{
  "name": "runway",
  "private": true,
  "description": "Deploy AI applications safely on your own server",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@9.15.4",
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"],
    "overrides": {
      "protobufjs": ">=7.5.6",
      "@protobufjs/utf8": ">=1.1.1",
      "fast-uri": ">=3.1.1",
      "ip-address": ">=10.1.1",
      "qs": ">=6.15.2",
      "uuid": ">=11.1.1"
    }
  },
  "scripts": {
    "dev": "pnpm -r dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r --if-present test",
    "mcp:build": "pnpm --filter @runway/mcp build",
    "mcp:path": "node -e \"console.log(require('path').resolve('packages/mcp/dist/index.js'))\"",
    "audit": "pnpm -r audit",
    "backup": "bash scripts/backup-db.sh"
  }
}
